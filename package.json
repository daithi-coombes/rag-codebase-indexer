{
  "name": "rag-codebase-indexer",
  "version": "0.0.1",
  "description": "Codebase indexer for RAG systems",
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "files": [
    "index.js",
    "lib",
    "config",
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "node build.js",
    "prepublishOnly": "npm run build",
    "start": "node ./bin/cli.js",
    "index": "node ./bin/cli.js index",
    "ingest": "node ./bin/cli.js ingest",
    "search": "node ./bin/cli.js search",
    "analyze": "node ./bin/cli.js analyze",
    "check": "npm-check",
    "coverage": "NODE_ENV=test c8 node --test",
    "lint": "eslint",
    "test": "NODE_ENV=test node --test",
    "test:debug": "NODE_ENV=test node --inspect-brk --test"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "chromadb": "^1.8.0",
    "esbuild": "^0.28.0",
    "faiss-node": "^0.5.1",
    "fast-glob": "^3.3.3",
    "lodash": "^4.18.1",
    "ollama": "^0.5.18",
    "tree-sitter": "^0.21.1",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-typescript": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^10.1.3",
    "eslint": "^10.2.0",
    "globals": "^17.5.0",
    "mock-fs": "^5.5.0",
    "nock": "^14.0.12",
    "npm-check": "^6.0.1"
  }
}
